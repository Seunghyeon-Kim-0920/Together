{
  "id": "/",
  "name": "Together — Global Travel Planner",
  "short_name": "Together",
  "description": "Plan multi-city trips by door-to-door travel time and settle shared expenses.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f7f4ee",
  "theme_color": "#071b3a",
  "lang": "ko",
  "dir": "ltr",
  "orientation": "any",
  "categories": ["travel", "navigation", "finance", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
